__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyd
*.pyo

# --- Testing, Profiling & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.pyre/

