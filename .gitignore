*.faiss
*.index

# --- Machine Learning Temporary Artifacts & Checkpoints ---
*.checkpoint
*.tmp
*.bak
*.swp
*.swo

# --- Logs, Telemetry & Debugging ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Environment & Secret Configuration ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# --- IDE & Editor Configuration ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*~

# --- Jupyter Notebook Caches ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
